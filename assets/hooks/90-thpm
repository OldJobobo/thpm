#!/usr/bin/env bash

if [[ -n ${THPM_HOOK_REPORT:-} ]]; then
  exec thpm --json hook-run theme-set "$@" >"$THPM_HOOK_REPORT"
fi

# Omarchy intentionally discards theme-hook stdout. Send the compact human
# report to stderr so terminal-driven theme changes still show every outcome.
exec thpm hook-run theme-set "$@" --quiet >&2
