# Generated by Omarchy from a THPM-owned template.
set -gx THPM_THEME_BG "{{ background }}"
set -gx THPM_THEME_FG "{{ foreground }}"
set -gx THPM_THEME_ACCENT "{{ blue }}"
set -gx THPM_THEME_MUTED "{{ muted }}"

# Fish syntax highlighting and completion pager colors.
set -g fish_color_normal "{{ foreground }}"
set -g fish_color_command "{{ blue }}"
set -g fish_color_keyword "{{ magenta }}"
set -g fish_color_quote "{{ green }}"
set -g fish_color_redirection "{{ cyan }}"
set -g fish_color_end "{{ yellow }}"
set -g fish_color_error "{{ red }}"
set -g fish_color_param "{{ foreground }}"
set -g fish_color_comment "{{ muted }}"
set -g fish_color_selection "{{ bright_foreground }}" "--background={{ selection }}"
set -g fish_color_search_match "{{ bright_foreground }}" "--background={{ selection }}"
set -g fish_color_operator "{{ cyan }}"
set -g fish_color_escape "{{ magenta }}"
set -g fish_color_autosuggestion "{{ muted }}"
set -g fish_pager_color_progress "{{ muted }}"
set -g fish_pager_color_prefix "{{ blue }}" --bold
set -g fish_pager_color_completion "{{ foreground }}"
set -g fish_pager_color_description "{{ muted }}"
set -g fish_pager_color_selected_background "--background={{ selection }}" "{{ bright_foreground }}"
